# server/.env.test (new, not committed — same .gitignore rules as .env)
DATABASE_URL="postgresql://inkwell:inkwell@localhost:5432/inkwell_test"

# .env.test is not loaded automatically by anything (dotenv only auto-loads
# .env, and prisma7.config.ts hardcodes .env too) -- DATABASE_URL must be# supplied explicitly, or this silently migrates inkwell_devagain instead
# of inkwell_test:
DATABASE_URL="postgresql://inkwell:inkwell@localhost:5432/inkwell_test" npx prisma migrate deploy --schema=prisma/schema.prisma