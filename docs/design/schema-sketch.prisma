// docs/design/schema-sketch.prisma — design sketch, not yet w
ired into server/
// Illustrates Section 5.2's design decisions in the Prisma sc
hema language
model User {
id           String   @id @default(uuid())
email        String   @unique
displayName  String
passwordHash String
isVerified   Boolean  @default(false)
createdAt    DateTime @default(now())
posts        Post[]
}
enum PostStatus {
DRAFT
PUBLISHED
}
model Post {
id          String     @id @default(uuid())
authorId    String
author      User       @relation(fields: [authorId], referen
ces: [id])
title       String
body        String
status      PostStatus @default(DRAFT)
publishedAt DateTime?
createdAt   DateTime   @default(now())
}